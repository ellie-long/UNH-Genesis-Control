  </widget>
  <widget type="slide_button" version="2.0.0">
    <name>Output_Control</name>
    <pv_name>ca://$(P):OUTPUT_CMD</pv_name>
    <label />
    <x>145</x>
    <y>170</y>
    <width>120</width>
    <height>25</height>
    <tooltip>Toggle supply output. Requires an active connection; the IOC may also be configured read-only.</tooltip>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):COMM</pv_name>
      </rule>
    </rules>
  </widget>
