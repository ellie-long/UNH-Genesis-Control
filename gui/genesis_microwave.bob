  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Voltage_Setpoint</name>
    <pv_name>ca://$(P):VSET_CMD</pv_name>
    <x>145</x>
    <y>385</y>
    <width>120</width>
    <precision>3</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):COMM</pv_name>
      </rule>
    </rules>
    <tooltip>Controller enforces code-only ceilings. Rejected requests appear in Last error. Values refresh on the next successful poll.</tooltip>
  </widget>
