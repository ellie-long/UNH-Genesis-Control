<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Genesis Microwave - SIGLENT SDS814X HD</name>
  <width>1100</width>
  <height>670</height>
  <macros>
    <P>UNH:GEN:MW:SCOPE</P>
    <C>SIG</C>
  </macros>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <x>20</x>
    <y>15</y>
    <width>800</width>
    <height>32</height>
    <text>Microwave Reflector - SIGLENT SDS814X HD</text>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22" />
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Prefix</name>
    <x>20</x>
    <y>52</y>
    <width>1050</width>
    <height>24</height>
    <text>$(P):$(C)_VI | Using the scope’s saved acquisition settings</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Reading label</name>
    <x>20</x>
    <y>95</y>
    <width>165</width>
    <height>30</height>
    <text>CH1 voltage (V)</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Reading</name>
    <x>185</x>
    <y>88</y>
    <width>280</width>
    <height>44</height>
    <pv_name>ca://$(P):$(C)_VI</pv_name>
    <precision>6</precision>
    <font>
      <font family="Liberation Sans" style="BOLD" size="26" />
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Connected label</name>
    <x>490</x>
    <y>88</y>
    <width>180</width>
    <height>22</height>
    <text>Connected</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Connected</name>
    <x>490</x>
    <y>113</y>
    <width>180</width>
    <height>25</height>
    <pv_name>ca://$(P):$(C)_Comm_Status</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Live valid label</name>
    <x>685</x>
    <y>88</y>
    <width>180</width>
    <height>22</height>
    <text>Live valid</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Live valid</name>
    <x>685</x>
    <y>113</y>
    <width>180</width>
    <height>25</height>
    <pv_name>ca://$(P):$(C)_Data_Valid</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Acquisition label</name>
    <x>880</x>
    <y>88</y>
    <width>180</width>
    <height>22</height>
    <text>Acquisition</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Acquisition</name>
    <x>880</x>
    <y>113</y>
    <width>180</width>
    <height>25</height>
    <pv_name>ca://$(P):$(C)_Acq_Status</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Error label</name>
    <x>20</x>
    <y>150</y>
    <width>85</width>
    <height>24</height>
    <text>Last error</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Error</name>
    <x>110</x>
    <y>150</y>
    <width>680</width>
    <height>24</height>
    <pv_name>ca://$(P):$(C)_Last_Error</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Age label</name>
    <x>805</x>
    <y>150</y>
    <width>135</width>
    <height>24</height>
    <text>Data age (s)</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Age</name>
    <x>940</x>
    <y>150</y>
    <width>140</width>
    <height>24</height>
    <pv_name>ca://$(P):$(C)_Data_Age</pv_name>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>CH1 waveform</name>
    <x>20</x>
    <y>190</y>
    <width>1060</width>
    <height>205</height>
    <show_toolbar>true</show_toolbar>
    <show_legend>false</show_legend>
    <title>Latest CH1 waveform</title>
    <x_axis>
      <title>Time (s)</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <show_grid>true</show_grid>
      <minimum>-0.005</minimum>
      <maximum>0.005</maximum>
    </x_axis>
    <y_axes>
      <axis>
        <title>Voltage (V)</title>
        <autoscale>true</autoscale>
        <minimum>-0.7</minimum>
        <maximum>0.7</maximum>
        <log_scale>false</log_scale>
        <show_grid>true</show_grid>
      </axis>
    </y_axes>
    <traces>
      <trace>
        <name>CH1 waveform volts</name>
        <x_pv>ca://$(P):$(C)_Wave_Time</x_pv>
        <y_pv>ca://$(P):$(C)_Wave_Volts</y_pv>
        <err_pv />
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="102" blue="204" />
        </color>
        <line_width>2</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>CH1 history</name>
    <x>20</x>
    <y>405</y>
    <width>1060</width>
    <height>215</height>
    <show_toolbar>true</show_toolbar>
    <show_legend>false</show_legend>
    <title>CH1 voltage history - last 5 minutes</title>
    <x_axis>
      <title>Seconds before now</title>
      <autoscale>false</autoscale>
      <log_scale>false</log_scale>
      <show_grid>true</show_grid>
      <minimum>-300</minimum>
      <maximum>0</maximum>
    </x_axis>
    <y_axes>
      <axis>
        <title>Voltage (V)</title>
        <autoscale>true</autoscale>
        <minimum>-0.7</minimum>
        <maximum>0.7</maximum>
        <log_scale>false</log_scale>
        <show_grid>true</show_grid>
      </axis>
    </y_axes>
    <traces>
      <trace>
        <name>CH1 reading</name>
        <x_pv>ca://$(P):$(C)_History_Time</x_pv>
        <y_pv>ca://$(P):$(C)_History_Reading</y_pv>
        <err_pv />
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="102" blue="204" />
        </color>
        <line_width>2</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Footer</name>
    <x>20</x>
    <y>635</y>
    <width>1060</width>
    <height>25</height>
    <text>Use graph tools to zoom or change the time axis. Five minutes of readings are held in memory; no data is saved.</text>
  </widget>
</display>