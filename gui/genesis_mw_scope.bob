<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Genesis Microwave - SIGLENT CH1</name>
  <width>1100</width>
  <height>620</height>
  <macros>
    <P>UNH:GEN:MW:SCOPE</P>
    <C>SIG</C>
  </macros>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <x>20</x><y>15</y><width>950</width><height>32</height>
    <text>Microwave Reflector - SIGLENT CH1</text>
    <font><font family="Liberation Sans" style="BOLD" size="22" /></font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Reading label</name>
    <x>20</x><y>80</y><width>225</width><height>32</height>
    <text>CH1 mean voltage (V)</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>CH1 mean voltage</name>
    <x>240</x><y>72</y><width>320</width><height>50</height>
    <pv_name>ca://$(P):$(C)_VI</pv_name>
    <precision>6</precision>
    <font><font family="Liberation Sans" style="BOLD" size="26" /></font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Connected label</name>
    <x>600</x><y>78</y><width>170</width><height>23</height>
    <text>Connected</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Connected</name>
    <x>600</x><y>107</y><width>170</width><height>28</height>
    <pv_name>ca://$(P):$(C)_Comm_Status</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Valid label</name>
    <x>800</x><y>78</y><width>190</width><height>23</height>
    <text>Measurement valid</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Valid</name>
    <x>800</x><y>107</y><width>190</width><height>28</height>
    <pv_name>ca://$(P):$(C)_Data_Valid</pv_name>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Error label</name>
    <x>20</x><y>160</y><width>90</width><height>23</height>
    <text>Diagnostic</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Error</name>
    <x>120</x><y>156</y><width>920</width><height>28</height>
    <pv_name>ca://$(P):$(C)_Last_Error</pv_name>
  </widget>
  <widget type="stripchart" version="3.0.0">
    <name>CH1 mean live trend</name>
    <x>20</x><y>205</y><width>1060</width><height>365</height>
    <show_toolbar>true</show_toolbar>
    <show_legend>false</show_legend>
    <show_grid>true</show_grid>
    <title>CH1 mean voltage over time</title>
    <time_range>5 minutes</time_range>
    <y_axes>
      <axis>
        <title>Voltage (V)</title>
        <autoscale>true</autoscale>
        <minimum>-0.02</minimum>
        <maximum>0.02</maximum>
        <log_scale>false</log_scale>
        <show_grid>true</show_grid>
      </axis>
    </y_axes>
    <traces>
      <trace>
        <name>CH1 mean voltage</name>
        <y_pv>ca://$(P):$(C)_VI</y_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color><color red="0" green="102" blue="204" /></color>
        <line_width>2</line_width>
        <point_type>0</point_type>
      </trace>
    </traces>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Footer</name>
    <x>20</x><y>585</y><width>1060</width><height>26</height>
    <text>Read-only scalar measurement. Set Simple measurement source C1 and enable MEAN on the oscilloscope. No waveform transfers.</text>
  </widget>
</display>
