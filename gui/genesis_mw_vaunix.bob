  <widget type="label" version="2.0.0">
    <name>Vaunix_Safety_Note</name>
    <x>30</x>
    <y>745</y>
    <width>980</width>
    <height>55</height>
    <text>Raw Vaunix write controls are intentionally not exposed on this screen. Normal RF/frequency control uses the Microwave Supervisor. Direct device writes remain commissioning-only until physical source/VDI validation is complete.</text>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0" />
    </font>
    <wrap_words>true</wrap_words>
    <transparent>true</transparent>
