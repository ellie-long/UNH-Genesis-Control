  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Connection_Readback</name>
    <pv_name>pva://$(P):COMM</pv_name>
    <x>145</x>
    <y>115</y>
    <width>180</width>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Error_Label</name>
    <text>Last error:</text>
    <x>20</x>
    <y>150</y>
    <width>90</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Error_Readback</name>
