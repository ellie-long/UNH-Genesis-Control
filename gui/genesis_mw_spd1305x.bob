    <name>Output_CMD</name>
    <x>660</x>
    <y>352</y>
    <width>130</width>
    <height>28</height>
    <pv_name>pva://$(P):OUTPUT_CMD</pv_name>
    <label />
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply and RF OFF required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pv1 == 0 &amp;&amp; pvSev1 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pv1 == 0 &amp;&amp; pvSev1 == 0)">
          <value>false</value>
        </exp>
        <pv_name>pva://$(P):COMM</pv_name>
        <pv_name>pva://UNH:GEN:MW:SUP:RFActual</pv_name>
      </rule>
    </rules>
