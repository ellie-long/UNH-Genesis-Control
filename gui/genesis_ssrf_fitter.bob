  <widget type="xyplot" version="3.0.0">




    <name>NMR_Fit_Plot</name>




    <x>40</x>




    <y>830</y>




    <width>1180</width>




    <height>325</height>




    <title>NMR Spectrum and Fitter Result</title>




    <show_toolbar>true</show_toolbar>




    <background_color>




      <color red="255" green="255" blue="255"/>




    </background_color>




    <foreground_color>




      <color red="0" green="0" blue="0"/>




    </foreground_color>




    <grid_color>




      <color red="210" green="215" blue="220"/>




    </grid_color>




    <x_axis>




      <title>Frequency (MHz)</title>




      <autoscale>true</autoscale>




      <log_scale>false</log_scale>




      <show_grid>true</show_grid>




    </x_axis>




    <y_axes>




      <y_axis>




        <title>NMR Signal (arb. units)</title>




        <autoscale>true</autoscale>




        <log_scale>false</log_scale>




        <show_grid>true</show_grid>




        <on_right>false</on_right>




      </y_axis>




    </y_axes>




    <traces>




      <trace>




        <name>Processed NMR</name>




        <x_pv>pva://$(P):FREQS_MHZ</x_pv>




        <y_pv>pva://$(P):DATA</y_pv>




        <axis>0</axis>




        <trace_type>1</trace_type>




        <line_width>2</line_width>




        <color>




          <color red="0" green="53" blue="145"/>




        </color>




      </trace>




      <trace>




        <name>Total Fit</name>




        <x_pv>pva://$(P):FREQS_MHZ</x_pv>




        <y_pv>pva://$(P):TOTAL_FIT</y_pv>




        <axis>0</axis>




        <trace_type>1</trace_type>




        <line_width>2</line_width>




        <color>




          <color red="200" green="50" blue="50"/>




        </color>




      </trace>




    </traces>




  </widget>




