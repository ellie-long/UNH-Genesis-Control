  <widget type="bool_button" version="2.0.0">
    <name>RF_Switch_PORT_CMD</name>
    <x>705</x>
    <y>398</y>
    <width>145</width>
    <height>30</height>
    <pv_name>pva://UNH:GEN:SSRF:RF_SW:PORT_CMD</pv_name>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected and hardware writes enabled" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0)">
          <value>false</value>
        </exp>
        <pv_name>pva://UNH:GEN:SSRF:RF_SW:COMM</pv_name>
        <pv_name>pva://UNH:GEN:SSRF:RF_SW:WRITE_ENABLED</pv_name>
      </rule>
    </rules>
    <tooltip>0 = PORT1, 1 = PORT2. Command executes only when COMM=Connected and writes are enabled.</tooltip>
  </widget>
