  <widget type="label" version="2.0.0">
    <name>Limit_Help</name>
    <x>20</x>
    <y>525</y>
    <width>640</width>
    <height>25</height>
    <text>Output caps: 5 V / 0.1 A. Protection defaults: 5.1 V / 0.11 A.</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Recovery_Help</name>
    <x>20</x>
    <y>555</y>
    <width>640</width>
    <height>25</height>
    <text>Reconnect leaves output OFF and resets voltage/current to zero.</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Recovery_Action</name>
    <x>20</x>
    <y>585</y>
    <width>640</width>
    <height>25</height>
    <text>Wait for Connected, set voltage/current, then enable output.</text>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Disconnected_Help</name>
    <x>20</x>
    <y>615</y>
    <width>640</width>
    <height>25</height>
    <text>While disconnected, readings may be stale; commands are not queued.</text>
  </widget>
