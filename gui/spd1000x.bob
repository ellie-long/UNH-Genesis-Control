  <widget type="label" version="2.0.0">
    <name>Current_Max_Label</name>
    <x>330</x>
    <y>495</y>
    <width>90</width>
    <height>25</height>
    <text>Current max:</text>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Current_Max</name>
    <x>420</x>
    <y>495</y>
    <width>120</width>
    <height>25</height>
    <pv_name>ca://$(P):CH1_CC.DRVH</pv_name>
