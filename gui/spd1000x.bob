<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Siglent SPD1000X Power Supply</name>
  <width>680</width>
  <height>660</height>
  <macros>
    <P>MYLAB</P>
  </macros>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>TITLE</class>
    <text>Siglent SPD1000X Power Supply</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>480</width>
    <height>31</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0" />
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0" />
    </foreground_color>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Prefix_Label</name>
    <class>COMMENT</class>
    <text>PV prefix: $(P)</text>
    <x>490</x>
    <y>8</y>
    <width>175</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Status_Heading</name>
    <class>COMMENT</class>
    <text>Supply status</text>
    <x>20</x>
    <y>55</y>
    <width>180</width>
    <height>25</height>
    <font use_class="true">
      <font name="Comment" family="Liberation Sans" style="ITALIC" size="14.0" />
    </font>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Connection_Label</name>
    <text>Connection:</text>
    <x>20</x>
    <y>90</y>
    <width>120</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Connection_Readback</name>
    <pv_name>ca://$(P):Comm_Status</pv_name>
    <x>145</x>
    <y>90</y>
    <width>180</width>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Error_Label</name>
    <text>Last error:</text>
    <x>20</x>
    <y>125</y>
    <width>90</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Error_Readback</name>
    <pv_name>ca://$(P):Last_Error</pv_name>
    <x>145</x>
    <y>125</y>
    <width>510</width>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Output_Label</name>
    <text>Output:</text>
    <x>20</x>
    <y>170</y>
    <width>120</width>
  </widget>
  <widget type="slide_button" version="2.0.0">
    <name>Output_Control</name>
    <pv_name>ca://$(P):CH1_Output</pv_name>
    <label />
    <x>145</x>
    <y>170</y>
    <width>120</width>
    <height>25</height>
    <tooltip>Toggle supply output. Wait for Connected before enabling. The IOC checks voltage/current limits and rejects disconnected commands.</tooltip>
    <enabled>true</enabled>
    </widget>
  <widget type="label" version="2.0.0">
    <name>Mode_Label</name>
    <text>Regulation:</text>
    <x>330</x>
    <y>170</y>
    <width>90</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Mode_Readback</name>
    <pv_name>ca://$(P):CH1_Mode</pv_name>
    <x>420</x>
    <y>170</y>
    <width>100</width>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Measurements_Heading</name>
    <class>COMMENT</class>
    <text>Live measurements</text>
    <x>20</x>
    <y>225</y>
    <width>180</width>
    <height>25</height>
    <font use_class="true">
      <font name="Comment" family="Liberation Sans" style="ITALIC" size="14.0" />
    </font>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Voltage_RBV_Label</name>
    <text>Voltage:</text>
    <x>20</x>
    <y>260</y>
    <width>120</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Voltage_Readback</name>
    <pv_name>ca://$(P):CH1_VI</pv_name>
    <x>145</x>
    <y>260</y>
    <width>120</width>
    <precision>3</precision>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Voltage_Units</name>
    <text>V</text>
    <x>275</x>
    <y>260</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Current_RBV_Label</name>
    <text>Current:</text>
    <x>330</x>
    <y>260</y>
    <width>90</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Current_Readback</name>
    <pv_name>ca://$(P):CH1_CI</pv_name>
    <x>420</x>
    <y>260</y>
    <width>120</width>
    <precision>3</precision>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Current_Units</name>
    <text>A</text>
    <x>550</x>
    <y>260</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Power_RBV_Label</name>
    <text>Power:</text>
    <x>20</x>
    <y>295</y>
    <width>120</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Power_Readback</name>
    <pv_name>ca://$(P):CH1_PI</pv_name>
    <x>145</x>
    <y>295</y>
    <width>120</width>
    <precision>3</precision>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Power_Units</name>
    <text>W</text>
    <x>275</x>
    <y>295</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Settings_Heading</name>
    <class>COMMENT</class>
    <text>Output commands</text>
    <x>20</x>
    <y>350</y>
    <width>180</width>
    <height>25</height>
    <font use_class="true">
      <font name="Comment" family="Liberation Sans" style="ITALIC" size="14.0" />
    </font>
    <transparent use_class="true">true</transparent>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Voltage_SP_Label</name>
    <text>Voltage setpoint:</text>
    <x>20</x>
    <y>385</y>
    <width>120</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Voltage_Setpoint</name>
    <pv_name>ca://$(P):CH1_VC</pv_name>
    <x>145</x>
    <y>385</y>
    <width>120</width>
    <precision>3</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):Comm_Status</pv_name>
      </rule>
    </rules>
    <tooltip>Controller enforces code-only ceilings. Rejected requests appear in Last error. Values refresh on the next successful poll.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Voltage_SP_Units</name>
    <text>V</text>
    <x>275</x>
    <y>385</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Current_SP_Label</name>
    <text>Current limit:</text>
    <x>330</x>
    <y>385</y>
    <width>90</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Current_Setpoint</name>
    <pv_name>ca://$(P):CH1_CC</pv_name>
    <x>420</x>
    <y>385</y>
    <width>120</width>
    <precision>3</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):Comm_Status</pv_name>
      </rule>
    </rules>
    <tooltip>Controller enforces code-only ceilings. Rejected requests appear in Last error. Values refresh on the next successful poll.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Current_SP_Units</name>
    <text>A</text>
    <x>550</x>
    <y>385</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>OVP_Label</name>
    <text>OVP limit:</text>
    <x>20</x>
    <y>420</y>
    <width>120</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>OVP_Setpoint</name>
    <pv_name>ca://$(P):CH1_OVP</pv_name>
    <x>145</x>
    <y>420</y>
    <width>120</width>
    <precision>3</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):Comm_Status</pv_name>
      </rule>
    </rules>
    <tooltip>Protection trip threshold. Default and maximum: 5.100 V. Reapplied on reconnect. Output command limits remain 5.000 V / 0.100 A.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>OVP_Units</name>
    <text>V</text>
    <x>275</x>
    <y>420</y>
    <width>30</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>OCP_Label</name>
    <text>OCP limit:</text>
    <x>330</x>
    <y>420</y>
    <width>90</width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>OCP_Setpoint</name>
    <pv_name>ca://$(P):CH1_OCP</pv_name>
    <x>420</x>
    <y>420</y>
    <width>120</width>
    <precision>3</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected supply required" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):Comm_Status</pv_name>
      </rule>
    </rules>
    <tooltip>Protection trip threshold. Default and maximum: 0.110 A. Reapplied on reconnect. Output command limits remain 5.000 V / 0.100 A.</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>OCP_Units</name>
    <text>A</text>
    <x>550</x>
