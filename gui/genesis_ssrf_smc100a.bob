  <widget type="textentry" version="3.0.0">
    <name>Freq_CMD</name>
    <x>175</x>
    <y>347</y>
    <width>120</width>
    <height>25</height>
    <pv_name>ca://$(P):FREQ_CMD</pv_name>
    <precision>6</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected and hardware writes enabled" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://$(P):COMM</pv_name>
        <pv_name>ca://$(P):WRITE_ENABLED</pv_name>
      </rule>
    </rules>
    <tooltip>SMC100A carrier frequency command in MHz.</tooltip>
  </widget>
