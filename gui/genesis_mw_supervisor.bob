    <pv_name>ca://$(P):RFActual</pv_name>
    <bit>0</bit>
    <off_color>
      <color red="150" green="155" blue="160" />
    </off_color>
    <on_color>
      <color red="30" green="160" blue="70" />
    </on_color>
    <visible>false</visible>
    <rules>
      <rule name="Fresh RF readback only" prop_id="visible" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0"><value>true</value></exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0)"><value>false</value></exp>
        <pv_name>ca://$(P):RFValid</pv_name>
      </rule>
    </rules>
  </widget>
