<display version="2.0.0">
  <name>Genesis Cryo - Ion Gauge</name>
  <width>1400</width>
  <height>480</height>
  <widget type="label" version="2.0.0">
    <name>Title_ionivac</name>
    <x>10</x>
    <y>10</y>
    <width>1380</width>
    <height>31</height>
    <text>ionivac</text>
    <transparent>true</transparent>
    <class>TITLE</class>
  </widget>
