  <widget type="action_button" version="3.0.0"><name>HeaterOnButton</name><x>466</x><y>446</y><width>214</width><height>32</height><actions><action type="write_pv"><pv_name>ca://UNH:GEN:MAG:HEATER_ON_CMD</pv_name><value>1</value><description>Heater ON (driven)</description></action></actions><text>Heater ON (driven)</text><font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font><show_confirm_dialog>true</show_confirm_dialog><confirm_message>Open the superconducting switch? Only after the supply current matches the persistent current; 20 s wait.</confirm_message></widget>
  <widget type="action_button" version="3.0.0"><name>HeaterOffButton</name><x>690</x><y>446</y><width>214</width><height>32</height><actions><action type="write_pv"><pv_name>ca://UNH:GEN:MAG:HEATER_OFF_CMD</pv_name><value>1</value><description>Heater OFF (persistent)</description></action></actions><text>Heater OFF (persistent)</text><font><font family="Liberation Sans" style="REGULAR" size="11.0"/></font><show_confirm_dialog>true</show_confirm_dialog><confirm_message>Close the superconducting switch and make the magnet persistent? 20 s wait; the supply stays energized (this cool-down).</confirm_message></widget>
