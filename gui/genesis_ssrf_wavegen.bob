  <widget type="textentry" version="3.0.0">
    <name>PERIOD_CMD_Control</name>
    <x>175</x>
    <y>390</y>
    <width>125</width>
    <height>28</height>
    <pv_name>ca://UNH:GEN:SSRF:WGEN:PERIOD_CMD</pv_name>
    <precision>6</precision>
    <enabled>false</enabled>
    <rules>
      <rule name="Connected and hardware writes enabled" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="!(pv0 == 1 &amp;&amp; pv1 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pvSev1 == 0)">
          <value>false</value>
        </exp>
        <pv_name>ca://UNH:GEN:SSRF:WGEN:COMM</pv_name>
        <pv_name>ca://UNH:GEN:SSRF:WGEN:WRITE_ENABLED</pv_name>
      </rule>
    </rules>
    <tooltip>IOC write gate must be explicitly enabled.</tooltip>
  </widget>
