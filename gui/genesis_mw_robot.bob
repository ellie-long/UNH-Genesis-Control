  <widget type="action_button" version="3.0.0">
    <name>ESTOP</name>
    <x>200</x><y>637</y><width>150</width><height>42</height>
    <text>STOP ALL</text>
    <background_color><color red="200" green="50" blue="50" /></background_color>
    <foreground_color><color red="255" green="255" blue="255" /></foreground_color>
    <actions><action type="write_pv">
      <pv_name>pva://$(P):ESTOP</pv_name><value>1</value>
      <description>Software STOP ALL; disable ownership and preserve holding current</description>
    </action></actions>
    <tooltip>Software stop, not a hardware E-stop. Stops both axes and selects Disabled.</tooltip>
  </widget>
