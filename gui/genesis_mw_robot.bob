  <widget type="action_button" version="3.0.0">
    <name>X_Jog_Minus</name><x>875</x><y>413</y><width>60</width><height>36</height>
    <text>X−</text>
    <actions><action type="write_pv"><pv_name>pva://$(P):X_JOG</pv_name><value>-1</value><description>Jog X− by selected distance in cm</description></action></actions>
    <tooltip>One bounded jog per click. Requires healthy EPICS ownership and both axes idle, fresh and motor-enabled. IOC checks remain authoritative.</tooltip>
    <enabled>false</enabled>
    <rules><rule name="Healthy EPICS ownership and both axes ready" prop_id="enabled" out_exp="false">
      <exp bool_exp="pv0 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pv1 == 1 &amp;&amp; pvSev1 == 0 &amp;&amp; pv2 == 0 &amp;&amp; pvSev2 == 0 &amp;&amp; pv3 == 0 &amp;&amp; pvSev3 == 0 &amp;&amp; pv4 == 1 &amp;&amp; pvSev4 == 0 &amp;&amp; pv5 == 1 &amp;&amp; pvSev5 == 0 &amp;&amp; pv6 == 1 &amp;&amp; pvSev6 == 0 &amp;&amp; pv7 == 1 &amp;&amp; pvSev7 == 0"><value>true</value></exp>
      <exp bool_exp="!(pv0 == 1 &amp;&amp; pvSev0 == 0 &amp;&amp; pv1 == 1 &amp;&amp; pvSev1 == 0 &amp;&amp; pv2 == 0 &amp;&amp; pvSev2 == 0 &amp;&amp; pv3 == 0 &amp;&amp; pvSev3 == 0 &amp;&amp; pv4 == 1 &amp;&amp; pvSev4 == 0 &amp;&amp; pv5 == 1 &amp;&amp; pvSev5 == 0 &amp;&amp; pv6 == 1 &amp;&amp; pvSev6 == 0 &amp;&amp; pv7 == 1 &amp;&amp; pvSev7 == 0)"><value>false</value></exp>
      <pv_name>pva://$(P):COMM_STATUS</pv_name>
      <pv_name>pva://$(P):CONTROL_MODE</pv_name>
      <pv_name>pva://$(P):X_BUSY</pv_name>
      <pv_name>pva://$(P):Y_BUSY</pv_name>
      <pv_name>pva://$(P):X_POSITION_FRESH</pv_name>
      <pv_name>pva://$(P):Y_POSITION_FRESH</pv_name>
      <pv_name>pva://$(P):X_MOTOR_ENABLE</pv_name>
      <pv_name>pva://$(P):Y_MOTOR_ENABLE</pv_name>
    </rule></rules>
  </widget>
