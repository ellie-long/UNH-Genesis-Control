[Unit]
Description=Vaunix Lab Brick TCP shim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/unhpoltarg/vaunix_shim
ExecStart=/usr/bin/python3 /home/unhpoltarg/vaunix_shim/vaunix_shim.py --library /home/unhpoltarg/vaunix_shim/liblmshid.so --bind 0.0.0.0 --port 1701 --lease-timeout 6 --serial 15033 --minimum-hz 11500000000 --maximum-hz 11833333333
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
